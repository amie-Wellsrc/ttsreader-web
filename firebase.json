{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [ {
      "source": "/api/fetchHtml",
      "function": {
        "functionId": "fetchHtml",
        "region": "us-central1"
      }
    },
      {
        "source": "/api/paypalWebhook265465",
        "function": {
          "functionId": "handlePayPalWebhook",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/ttsSync",
        "function": {
          "functionId": "tts",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/ttsAsync",
        "function": {
          "functionId": "functionTtsLong",
          "region": "us-central1"
        }
      },
      { "source": "/mcp", "function": { "functionId": "apiV1", "region": "us-central1" } },
      { "source": "/mcp/docs", "function": { "functionId": "apiV1", "region": "us-central1" } },
      { "source": "/api/v1/**", "function": { "functionId": "apiV1", "region": "us-central1" } },
      { "source": "/api/llms.txt", "function": { "functionId": "apiV1", "region": "us-central1" } },
      { "source": "/api/llms-full.txt", "function": { "functionId": "apiV1", "region": "us-central1" } },
      { "source": "/oauth/authorize", "function": { "functionId": "apiV1", "region": "us-central1" } },
      { "source": "/oauth/request/**", "function": { "functionId": "apiV1", "region": "us-central1" } },
      { "source": "/oauth/consent", "function": { "functionId": "apiV1", "region": "us-central1" } },
      { "source": "/oauth/token", "function": { "functionId": "apiV1", "region": "us-central1" } },
      { "source": "/oauth/revoke", "function": { "functionId": "apiV1", "region": "us-central1" } },
      { "source": "/oauth/jwks.json", "function": { "functionId": "apiV1", "region": "us-central1" } },
      { "source": "/.well-known/oauth-protected-resource", "function": { "functionId": "apiV1", "region": "us-central1" } },
      { "source": "/.well-known/oauth-protected-resource/mcp", "function": { "functionId": "apiV1", "region": "us-central1" } },
      { "source": "/.well-known/oauth-authorization-server", "function": { "functionId": "apiV1", "region": "us-central1" } },
      { "source": "/.well-known/openid-configuration", "function": { "functionId": "apiV1", "region": "us-central1" } },
      { "source": "/.well-known/openai-apps-challenge", "function": { "functionId": "apiV1", "region": "us-central1" } }
